# SiteTrack Pro — MCP server credentials
#
# These power the MCP servers declared in .mcp.json. They are SEPARATE from
# the app's runtime env (.env.local) — these are developer-machine tokens for
# Claude Code to talk to Supabase / GitHub / Postgres on YOUR behalf.
#
# SETUP:
#   1. cp .env.mcp.example .env.mcp
#   2. Fill in the real values below
#   3. Load them before launching Claude Code:
#        - bash/zsh:  set -a; source .env.mcp; set +a
#        - PowerShell: Get-Content .env.mcp | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
#   4. Restart Claude Code so .mcp.json picks up the expanded vars.
#
# .env.mcp is gitignored — it NEVER gets committed. Only .env.mcp.example does.
#
# SECURITY: All four MCP servers run on YOUR machine with YOUR tokens.
#   - Supabase MCP runs --read-only by default (cannot mutate data). Drop the
#     flag in .mcp.json only when you explicitly need write access.
#   - Use least-privilege tokens. Rotate immediately if any leak.

# ── Supabase MCP ─────────────────────────────────────────────────────────────
# Personal Access Token: Supabase Dashboard → Account → Access Tokens → Generate
# (NOT the service_role key, NOT the anon key — a dashboard PAT.)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Project ref: the subdomain of your project URL.
# https://abcdefghijklmno.supabase.co  →  abcdefghijklmno
SUPABASE_PROJECT_REF=your_project_ref

# ── Postgres MCP ─────────────────────────────────────────────────────────────
# Direct connection string (Supabase Dashboard → Settings → Database → URI).
# Used by the postgres MCP for raw SQL (RLS test matrices, debugging).
SUPABASE_DB_URL=postgresql://postgres.your_ref:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── GitHub MCP ───────────────────────────────────────────────────────────────
# Fine-grained PAT: github.com → Settings → Developer settings → Fine-grained
# tokens. Scope it to the Site-Tracker-Pro repo only. Grant:
#   Contents: read+write · Pull requests: read+write · Issues: read+write ·
#   Actions: read · Metadata: read
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
