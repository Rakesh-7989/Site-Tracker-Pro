# SiteTrack Pro — environment variables (v3, zero-spend-aware)
#
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Vars are loaded by Vite for the frontend; Edge Functions read their
# own env from Supabase function secrets (push via
# `node scripts/sync-function-secrets.mjs` after editing this file).
#
# Cost classification per key (per docs/business/ZERO_SPEND_POLICY.md):
#   🆓  always-free        — no usage cap
#   📊  capped-free        — free tier with monthly cap; guard meters usage
#   💳  paid               — REFUSED when BUDGET_MODE=zero-spend (the default)
#
# Verify your config at any time:
#   node scripts/check-env-config.mjs
#
# ════════════════════════════════════════════════════════════════════════
#  ZERO-SPEND GUARD
# ════════════════════════════════════════════════════════════════════════
# Controls whether the budget guard refuses paid providers. Default is
# zero-spend so missing this var defaults to the safest mode.
# Allowed: zero-spend | paid
BUDGET_MODE=zero-spend

# ════════════════════════════════════════════════════════════════════════
#  FRONTEND (Vite — VITE_* vars ship in the JS bundle)
# ════════════════════════════════════════════════════════════════════════

# ── Backend mode ─────────────────────────────────────────────────────────
# "local"    = localStorage demo (no auth, no real persistence)
# "supabase" = Supabase auth + persistence
VITE_BACKEND=supabase

# ── Supabase (required when VITE_BACKEND=supabase) ──────────────────────
# 📊 supabase-free
# Project Settings → API. NEVER paste service_role here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ── App URL (for share links + redirects) ───────────────────────────────
VITE_APP_URL=https://sitetrackpro.in

# ── Staff email allow-list (comma-separated, for STUB_VIEWS access) ─────
VITE_STAFF_EMAILS=boyapatirakesh7989@gmail.com

# ── Sentry browser DSN (OPTIONAL) ───────────────────────────────────────
# 📊 sentry — free tier: 5k errors/mo, 7-day retention.
# See docs/setup/SENTRY_SETUP.md
VITE_SENTRY_DSN=

# ════════════════════════════════════════════════════════════════════════
#  EDGE FUNCTIONS (Supabase function secrets)
#  These NEVER reach the browser. Push to Supabase via:
#    node scripts/sync-function-secrets.mjs
# ════════════════════════════════════════════════════════════════════════

# ── Supabase admin context (auto-injected by Supabase, no need to set) ──
# SUPABASE_URL              — injected
# SUPABASE_SERVICE_ROLE_KEY — injected

# ── Bhashini voice transcription (voice_transcribe EF) ──────────────────
# 🆓 bhashini — free for startups (5-7 day approval).
# See docs/setup/BHASHINI_API_SETUP.md for application steps.
BHASHINI_API_KEY=

# ── AWS Transcribe (voice_transcribe EF — FALLBACK ONLY) ────────────────
# 💳 aws — ~$0.024/min audio. Blocked when BUDGET_MODE=zero-spend.
# Leave empty unless founder explicitly approves spend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── WhatsApp Business Cloud API (whatsapp_dpr_send + promoter_digest) ───
# 📊 whatsapp-meta — 1,000 free service conversations/mo per WABA.
# Guard refuses past cap unless WHATSAPP_OVERRIDE_PAID=1.
# See docs/archive/WHATSAPP_CLOUD_API_SETUP.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PERMANENT_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v18.0
# Set to "1" only when founder approves overage spend (₹0.40/msg beyond 1k).
WHATSAPP_OVERRIDE_PAID=
# Set to "true" during demo / acceptance testing so the EF returns success
# without actually hitting Meta. Leave empty in production.
SITETRACK_DRY_RUN=
# Set to "true" to enable real promoter_digest_cron sends. Defaults to
# dry-run when empty.
SITETRACK_DIGEST_LIVE=

# ── Polygon audit anchoring (anchor-digest EF) ──────────────────────────
# Default network = polygon-amoy (🆓 testnet, free MATIC from faucet).
# Mainnet (💳) requires BUDGET_MODE=paid AND POLYGON_NETWORK=polygon-mainnet.
# See docs/setup/POLYGON_AMOY_SETUP.md
POLYGON_NETWORK=polygon-amoy
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CONTRACT_ADDRESS=
POLYGON_SIGNER_URL=
POLYGON_SIGNER_TOKEN=
POLYGON_SIGNER_PRIVATE_KEY=
POLYGON_GAS_PRICE_GWEI=50
CRON_SECRET=

# ── BuildNow Telangana (buildnow_anchor EF) ─────────────────────────────
# 🆓 BuildNow has no API; we scrape with founder-supplied creds. Empty =
# disabled (returns mock-anchor status).
BUILDNOW_API_TOKEN=
BUILDNOW_SCRAPE_ENABLED=false

# ── Telangana RERA scraper (tg-rera-submit EF) ──────────────────────────
TG_RERA_SCRAPER_ENABLED=false
TG_RERA_PORTAL_URL=https://rera.telangana.gov.in
TG_RERA_USER=
TG_RERA_PASS=

# ── Cashfree subscriptions (cashfree-webhook + cashfree-subscription) ───
# 📊 cashfree — no monthly fee, 2% per txn. Wire only when first pilot
# signs and is ready to pay.
CASHFREE_APP_ID=
CASHFREE_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_RETURN_URL=https://sitetrackpro.in/billing/return
CASHFREE_NOTIFY_URL=https://YOUR_PROJECT.functions.supabase.co/cashfree-webhook
# Resend webhook signing secret (Svix format, whsec_...). Set in Resend
# dashboard -> Webhooks -> Signing secret. Used by resend-webhook EF to verify
# email delivery/bounce events. Push to Supabase via `supabase secrets set`.
RESEND_WEBHOOK_SECRET=
# Inbound mail to hello@sitetrackpro.in is forwarded here by resend-webhook
# (email.received events). Also pushed via `supabase secrets set`.
EMAIL_FORWARD_TO=
CASHFREE_ALLOWED_ORIGINS=https://sitetrackpro.in

# ── Razorpay one-off invoice payments (razorpay-payment-link + razorpay-webhook) ──
# 💳 razorpay — 2% per txn (no setup/maintenance fee). Use for one-off invoice
# payments via Razorpay Payment Links. Get keys from
# https://dashboard.razorpay.com/#/app/keys. The Razorpay KEY_SECRET is used as
# the webhook signing secret fallback (RAZORPAY_WEBHOOK_SECRET overrides it).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI providers (OPTIONAL — Sprint 4+) ─────────────────────────────────
# 💳 openai / anthropic-api — both blocked when BUDGET_MODE=zero-spend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ════════════════════════════════════════════════════════════════════════
#  LOCAL DEV ONLY (not pushed to Supabase)
# ════════════════════════════════════════════════════════════════════════

# Postgres URL for applying migrations via psql (NEVER exposed to client).
# Format: postgresql://postgres.<proj>:<pw>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
