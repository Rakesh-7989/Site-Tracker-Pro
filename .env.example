# SiteTrack Pro — environment variables
#
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Vars are loaded by Vite for the frontend; Edge Functions read their own
# env from the Supabase Dashboard (Functions → Settings → Environment).

# ════════════════════════════════════════════════════════════════════════
#  FRONTEND (Vite — vars prefixed VITE_* are exposed to the browser)
# ════════════════════════════════════════════════════════════════════════

# ── Backend mode ─────────────────────────────────────────────────────────
# "local"    = localStorage demo (default; no auth, no real persistence)
# "supabase" = Supabase auth + persistence (per docs/CONNECT_SUPABASE.md)
VITE_BACKEND=local

# ── Supabase (only required when VITE_BACKEND=supabase) ─────────────────
# Find these at: Supabase Dashboard → Project Settings → API
# NEVER paste the service_role key here — it bypasses RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ── Optional: Razorpay (legacy UPI flow — kept for compatibility) ────────
VITE_RAZORPAY_KEY_ID=

# ── Optional: explicit app URL (for share links + redirects) ────────────
VITE_APP_URL=https://app.sitetrack.in

# ════════════════════════════════════════════════════════════════════════
#  EDGE FUNCTIONS (Supabase — set via `supabase secrets set …` or Dashboard)
#  These NEVER reach the browser. If you accidentally put one in the VITE_*
#  block above, rotate the value immediately.
# ════════════════════════════════════════════════════════════════════════

# ── Cashfree (cashfree-subscription + cashfree-webhook EFs) ──────────────
CASHFREE_APP_ID=
CASHFREE_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox            # sandbox | production
CASHFREE_RETURN_URL=https://app.sitetrack.in/billing/return
CASHFREE_NOTIFY_URL=https://YOUR_PROJECT.functions.supabase.co/cashfree-webhook

# ── CORS allow-list (cashfree-subscription) ─────────────────────────────
# Comma-separated origins the EF will accept; * is forbidden in prod.
CASHFREE_ALLOWED_ORIGINS=https://app.sitetrack.in,https://staging.app.sitetrack.in

# ── Telangana RERA scraper (tg-rera-submit EF) ──────────────────────────
TG_RERA_SCRAPER_ENABLED=false   # flip to true only after testing
TG_RERA_PORTAL_URL=https://rera.telangana.gov.in
TG_RERA_USER=
TG_RERA_PASS=

# ── WhatsApp Business Cloud API ─────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PERMANENT_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Polygon audit anchoring (anchor-digest EF — planned) ─────────────────
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
POLYGON_SIGNER_PRIVATE_KEY=     # hex string, NEVER commit
POLYGON_GAS_PRICE_GWEI=50

# ── AI providers (lib/ai.js LLM client — OPTIONAL) ──────────────────────
# Only used by the forecast + DPR auto-summary features.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ════════════════════════════════════════════════════════════════════════
#  LOCAL DEV ONLY
# ════════════════════════════════════════════════════════════════════════

# Postgres URL for applying migrations via psql (NOT exposed to client).
# Format: postgresql://postgres.<proj>:<pw>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
