{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitetrack-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sitetrack-production",
      "database_id": "d68e001c-4012-4670-ad92-403d57266a5f",
      "migrations_dir": "../../cloudflare/database/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "3f19ff7d0d3047e58e61d040b33cf3bb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "sitetrack-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "sitetrack-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "sitetrack-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 1 * * *" // 01:00 UTC (06:30 AM IST) daily promoter digest & lifecycle cron
    ]
  }
}

