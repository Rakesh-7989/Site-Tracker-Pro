{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitetrack-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sitetrack-production",
      "database_id": "sitetrack-d1-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "sitetrack-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "sitetrack-notifications"
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 1 * * *" // 01:00 UTC (06:30 AM IST) daily promoter digest & lifecycle cron
    ]
  }
}

